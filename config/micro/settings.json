{
  "basename": true,
  "clipboard": "internal",
  "colorscheme": "dukeubuntu-tc",
  "diffgutter": true,
  "mkparents": true,
  "pluginrepos": ["https://raw.githubusercontent.com/himei-miyu/micro-plugin-prettier/main/repo.json"],
  "qouter.enable": "on",
  "savecursor": true,
  "tabstospaces": true,
  "prettier.tabwidth": 2,
  "prettier.autoformat": "on",
  "prettier.bracketsameline": "false",
  "prettier.htmlwhitespacesensitivity": "ignore",
  "prettier.cols": 120
}
